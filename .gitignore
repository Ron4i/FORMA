# ---------- Сборочный мусор и личное ----------
node_modules/
package-lock.json
.vercel/
.netlify/
dist/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---------- Профили Chrome из .verify (по 15 МБ каждый) ----------
.verify/.cprof-*/
.verify/.chrome-diag/
.verify/.cache/
.verify/.profiles/

# ---------- Скриншоты тестов (пересоздаются за секунды) ----------
.verify/*.png

# ---------- Cloudflare ----------
worker/.wrangler/
worker/.dev.vars
worker/node_modules/

# ---------- Нативная сборка (Capacitor) ----------
# Собирается командой phone\npm run apk, генерируется целиком заново,
# весит сотни мегабайт и не относится к исходникам.
phone/node_modules/
phone/www/
phone/android/
phone/ios/

# Ключ подписи — строго секрет. Потерянный ключ = невозможность обновления
# приложения в Google Play. Шаблон (keystore.properties.example) в git входит.
*.keystore
*.jks
keystore.properties

# ---------- Чужой проект в этой папке (WPF-«снеговик», не FORMA) ----------
build/

# ---------- Крупные личные файлы, которые случайно лежат в папке ----------
*.mp4
*.mkv
*.avi
*.mov
*.exe
*.pdf